classDiagram
    direction TB

    class MediadorCompra {
        <<interface>>
        +notificar(remitente, evento)
    }

    class CompraMediador {
        +notificar(remitente, evento)
    }

    class ServicioPedidos {
        +registrarPedido()
    }

    class ServicioInventario {
        +verificarYReservar()
        +liberarStock()
    }

    class ServicioPagos {
        +procesarPago()
    }

    class ServicioEnvios {
        +programarEnvio()
    }

    class ServicioNotificaciones {
        +enviarNotificacion()
    }

    %% Implementación de la Interfaz del Mediador (sin clase abstracta)
    MediadorCompra <|.. CompraMediador : implementa
    MediadorCompra <|.. ServicioPedidos : implementa
    MediadorCompra <|.. ServicioInventario : implementa
    MediadorCompra <|.. ServicioPagos : implementa
    MediadorCompra <|.. ServicioEnvios : implementa
    MediadorCompra <|.. ServicioNotificaciones : implementa

    %% Orquestación desde el mediador concreto hacia los servicios
    CompraMediador --> ServicioPedidos
    CompraMediador --> ServicioInventario
    CompraMediador --> ServicioPagos
    CompraMediador --> ServicioEnvios
    CompraMediador --> ServicioNotificaciones

    %% Estilo Blanco y Negro (Sin colores para diapositivas)
    classDef default fill:#ffffff,stroke:#000000,stroke-width:1px,color:#000000;

